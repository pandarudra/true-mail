generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Holiday calendar location — set once via the "set your location" prompt
  // on first calendar visit, editable afterwards.
  holidayCountry String?
  holidayRegion  String?

  // IANA zone (e.g. "Asia/Kolkata") — auto-detected client-side on first
  // load (see app/api/settings/timezone), editable in Settings. Required
  // for recurring-task reminders to fire at the right wall-clock time from
  // a server-side cron, which has no browser to read an offset from.
  timezone String?

  resendConnection   ResendConnection?
  gmailConnection    GmailConnection?
  domains            Domain[]
  mailboxes          Mailbox[]
  sessions           Session[]
  accounts           Account[]
  labels             Label[]
  taskLists          TaskList[]
  tasks              Task[]
  telegramConnection TelegramConnection?
  telegramLinkTokens TelegramLinkToken[]
  promises           Promise[]

  @@map("user")
}

model ResendConnection {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedAccessToken   String
  encryptedRefreshToken  String
  accessTokenExpiresAt   DateTime
  scope                  String
  webhookId              String
  encryptedWebhookSecret String
  createdAt              DateTime @default(now())
  domains                Domain[]
}

model Domain {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     ResendConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  resendDomainId String
  name           String           @unique
  status         String           @default("pending")
  dnsRecords     Json
  createdAt      DateTime         @default(now())
  mailboxes      Mailbox[]
}

model Mailbox {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId    String?
  domain      Domain?  @relation(fields: [domainId], references: [id], onDelete: Cascade)
  localPart   String
  address     String   @unique
  displayName String?
  isDefault   Boolean  @default(false)
  source      String   @default("resend")
  createdAt   DateTime @default(now())
  emails      Email[]
  gmailConnection GmailConnection?
}

model Email {
  id             String       @id @default(uuid())
  mailboxId      String
  mailbox        Mailbox      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  resendEmailId  String?
  gmailMessageId String?      @unique
  direction     String
  from          String
  to            String[]
  cc            String[]
  subject       String
  text          String?
  html          String?
  status        String
  read          Boolean      @default(false)
  starred       Boolean      @default(false)
  important     Boolean      @default(false)
  archived      Boolean      @default(false)
  spam          Boolean      @default(false)
  trashedAt     DateTime?
  sentAt        DateTime?
  receivedAt    DateTime?
  createdAt     DateTime     @default(now())
  labels        Label[]
  attachments   Attachment[]
  tasks         Task[]
  promises      Promise[]
}

model Attachment {
  id                 String   @id @default(uuid())
  emailId            String
  email              Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  filename           String
  contentType        String
  size               Int?
  // Outbound (compose) attachments — hosted on Cloudinary.
  cloudinaryUrl      String?
  cloudinaryPublicId String?
  // Inbound (received) attachments — content stays with Resend; a fresh
  // signed download URL is fetched on demand via this id.
  resendAttachmentId String?
  createdAt          DateTime @default(now())
}

model Label {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#6b7280")
  createdAt DateTime @default(now())
  emails    Email[]

  @@unique([userId, name])
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model TaskList {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#6b7280")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  tasks     Task[]

  @@unique([userId, name])
}

model Task {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listId        String
  list          TaskList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueAt         DateTime?
  dueHasTime    Boolean   @default(false)
  priority      Priority  @default(NORMAL)
  completed     Boolean   @default(false)
  completedAt   DateTime?
  position      Int       @default(0)
  sourceEmailId String?
  sourceEmail   Email?    @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  subtasks      Subtask[]
  promise       Promise?

  // Recurring task + reminder fields. recurrenceType: null means "not
  // recurring" — every task created before this feature, unaffected. See
  // lib/recurrence.ts for how nextOccurrenceAt is computed and advanced;
  // dueAt is kept in sync with it so every existing task-list/calendar view
  // needs no changes to show a recurring task's upcoming date.
  recurrenceType       RecurrenceType?
  recurrenceDaysOfWeek Int[]           @default([])
  recurrenceDayOfMonth Int?
  recurrenceEndAt      DateTime?
  reminderEnabled      Boolean         @default(false)
  reminderTime         String?
  nextOccurrenceAt     DateTime?
  snoozedUntil         DateTime?
}

enum RecurrenceType {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

enum PromiseDirection {
  INCOMING
  OUTGOING
}

enum PromiseStatus {
  ACTIVE
  FULFILLED
  DISMISSED
}

// Only durable state is stored (ACTIVE/FULFILLED/DISMISSED) — DUE_SOON and
// OVERDUE are derived at read time from status + dueAt (see
// lib/promises.ts#derivePromiseStatus), so they can never go stale.
model Promise {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction     PromiseDirection
  personName    String?
  personEmail   String?
  commitment    String
  dueAt         DateTime?
  status        PromiseStatus    @default(ACTIVE)
  confidence    Float?
  sourceEmailId String?
  sourceEmail   Email?           @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)
  relatedTaskId String?          @unique
  relatedTask   Task?            @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  fulfilledAt   DateTime?
  dismissedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Subtask {
  id        String  @id @default(uuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean @default(false)
  position  Int     @default(0)
}

model GmailConnection {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailboxId             String    @unique
  mailbox               Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  gmailEmail            String
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  lastSyncedAt          DateTime?
  historyId             String?
  createdAt             DateTime  @default(now())
}

model TelegramConnection {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramUserId    String   @unique
  telegramChatId    String   @unique
  username          String?
  connectedAt       DateTime @default(now())
  lastInteractionAt DateTime @default(now())
}

// Short-lived, single-use token used to link a Telegram account to a
// TrueMail user — see lib/telegram/auth.ts. `usedAt` + `expiresAt` cover
// the valid/expired/used/invalid states without a separate status field.
model TelegramLinkToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model HolidayCache {
  id        String   @id @default(uuid())
  country   String
  region    String   @default("")
  year      Int
  language  String   @default("en")
  data      Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@unique([country, region, year, language])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
