# Pooled connection (pgbouncer, transaction mode) — used at runtime.
DATABASE_URL="postgresql://user:password@host:6543/postgres?sslmode=require"
# Direct connection — required for `prisma migrate`. Supabase's pooler
# (above) doesn't support the DDL/prepared statements migrations need.
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"
# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="trHDRq6REmgp2487ED1iUE6YFWTMLQwmUo3FIfOvMgY="
BETTER_AUTH_SECRET="nGxX+inFW1ckmyEOvSMBfYSRPFDxhM94srwlaEWL7mM="
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public HTTPS URL Resend can reach to deliver webhooks. In development this
# is a tunnel (e.g. `ngrok http 3000`), separate from APP_URL/
# NEXT_PUBLIC_APP_URL so the browser keeps using localhost for everything
# else. In production, omit this — the resend-connection route falls back
# to APP_URL, which is your real deployed domain there.
RESEND_WEBHOOK_BASE_URL="https://your-tunnel.ngrok-free.dev"
# TrueMail's own Resend OAuth client (the "Connect with Resend" button).
# One-time setup: node scripts/register-resend-oauth-client.mjs $APP_URL
# Re-run it whenever APP_URL changes — the registered redirect_uri must
# match exactly.
RESEND_OAUTH_CLIENT_ID=""
RESEND_OAUTH_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Cloudinary (compose attachment uploads). Cloud name and API key are
# client-exposed by design (NEXT_PUBLIC_) — only the secret is server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# AI features (summarize, AI reply, ask your inbox) — a free-tier key from
# https://build.nvidia.com. Optional: those features return a 502 without it.
NVIDIA_API_KEY=""

